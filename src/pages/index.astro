---
import Base from '../layouts/Base.astro';
import { allTopics, allQuestions, allPapers, groupInfo, FIRST_SERIES } from '../lib/data';
import { decks } from '../lib/decks';
import Icon from '../components/Icon.astro';
const top = [...allTopics].sort((a, b) => b.marks - a.marks).slice(0, 14);
const topics = allTopics.map((t) => ({ slug: t.slug, name: t.name, parts: t.parts }));
const essays = allQuestions.filter((q) => q.format === 'Essay').length;
const scenarios = allQuestions.filter((q) => q.format === 'Scenario').length;
const sat = allPapers.filter((p) => p.kind === 'exam');
const latest = sat.map((p) => p.series).sort((a, b) => Number(b.split(' ')[1]) - Number(a.split(' ')[1]))[0];
---
<Base title="OCR A-level Law: past-paper questions by topic, mark schemes and a tutor" context="home" leadLine="Not sure where to start? Tell us the year group and target grade and we will arrange a trial lesson.">
  <h1>OCR A-level Law, one topic at a time</h1>
  <p>{allQuestions.length} questions from {allPapers.length} OCR Law papers, {FIRST_SERIES} to {latest} plus OCR's sample papers, sorted by topic, with the scenario, the mark scheme and the examiner's comment one tap away. Free, no sign-up.</p>
  <p class="muted">OCR A Level H418 and AS Level H018: the legal system, criminal law, law making, tort, the nature of law, human rights and contract. The June 2026 papers will be added when OCR publishes them.</p>

  <div class="progress-box" id="progress" hidden>
    <strong>Your progress</strong>
    <dl><div><dt>Checklist ticks</dt><dd id="pr-ticks">0</dd></div><div><dt>Questions marked</dt><dd id="pr-q">0</dd></div><div><dt>Weakest topic</dt><dd id="pr-weak">—</dd></div></dl>
    <a href="/planner/">Build a plan from these</a> · <a href="/specification/">Checklist</a>
  </div>

  <nav class="tool-strip" aria-label="Key tools">
    <a href="/practice/"><Icon name="target" />Practice</a>
    <a href="/past-papers/"><Icon name="file" />Past papers</a>
    <a href="/questions/type/scenarios/"><Icon name="lightbulb" />Scenarios</a>
    <a href="/essays/"><Icon name="pen" />Essays</a>
    <a href="/mock/"><Icon name="timer" />Mock</a>
  </nav>

  <label for="topic-search" class="muted">Find a topic</label>
  <input id="topic-search" class="search" type="search" placeholder="e.g. negligence, robbery, statutory interpretation" autocomplete="off" />

  <h2 class="strand-head">Most-examined topics</h2>
  <ul class="topic-list" id="topic-list">
    {top.map((t) => <li><a href={`/questions/${t.slug}/`}><span>{t.name}</span><span class="strand"><span class={`badge badge-${groupInfo(t.group).badge}`}>{groupInfo(t.group).short}</span> {t.parts} questions</span></a></li>)}
  </ul>
  <p><a href="/questions/">All {allTopics.length} topics by paper and section</a></p>

  <h2>Everything on the site</h2>
  <div class="tiles">
    <a class="tile-card" href="/past-papers/"><Icon name="file" /><strong>Past papers</strong><span>Every H418 and H018 paper since {FIRST_SERIES.split(' ')[1]} with a question-by-question table</span></a>
    <a class="tile-card" href="/practice/"><Icon name="target" /><strong>Practice</strong><span>Real questions one at a time, self-marked against the mark scheme and OCR's levels of response</span></a>
    <a class="tile-card" href="/questions/type/scenarios/"><Icon name="lightbulb" /><strong>Scenario questions</strong><span>All {scenarios} problem questions with their scenarios: advise whether, apply the law, conclude</span></a>
    <a class="tile-card" href="/essays/"><Icon name="pen" /><strong>Essays</strong><span>All {essays} essay titles set, by topic, and a timed essay tool</span></a>
    <a class="tile-card" href="/mock/"><Icon name="timer" /><strong>Mini-mock builder</strong><span>A paper-shaped timed mock from real questions: any A-level or AS paper, a section or the whole paper</span></a>
    <a class="tile-card" href="/specification/"><Icon name="checklist" /><strong>Spec checklist</strong><span>Every content line of the specification, tickable, linked to its questions</span></a>
    <a class="tile-card" href="/analysis/"><Icon name="chart" /><strong>What comes up</strong><span>Marks on each topic each year, the latest papers, every paper as a timeline</span></a>
    {decks.length > 0 && <a class="tile-card" href="/flashcards/"><Icon name="layers" /><strong>Key terms</strong><span>Key legal terms for {decks.length} topics as flip cards with spaced repetition</span></a>}
    <a class="tile-card" href="/grade-boundaries/"><Icon name="calendar" /><strong>Boundaries and dates</strong><span>Grade calculator and the 2027 exam dates with a countdown</span></a>
    <a class="tile-card" href="/planner/"><Icon name="lightbulb" /><strong>Revision planner</strong><span>A week-by-week plan to Paper 1 from your weak topics</span></a>
    <a class="tile-card" href="/tutors/"><Icon name="users" /><strong>Your tutor</strong><span>Sue: OCR A-level Law, online one-to-one</span></a>
  </div>

  <script define:vars={{ topics }}>
    try {
      const ticks = JSON.parse(localStorage.getItem('malt-spec') || '{}'), scores = JSON.parse(localStorage.getItem('malt-scores') || '{}');
      const nTicks = Object.values(ticks).filter(Boolean).length, rows = Object.entries(scores);
      const nQ = rows.reduce((n, [, r]) => n + (r.n || 0), 0);
      if (nTicks || nQ) {
        document.getElementById('progress').hidden = false;
        document.getElementById('pr-ticks').textContent = nTicks;
        document.getElementById('pr-q').textContent = nQ;
        const weak = rows.filter(([, r]) => r.total).sort((a, b) => a[1].earned / a[1].total - b[1].earned / b[1].total)[0];
        if (weak) { const t = topics.find((x) => x.slug === weak[0]); document.getElementById('pr-weak').innerHTML = t ? `<a href="/questions/${t.slug}/">${t.name.split(':')[0]}</a> ${Math.round(100 * weak[1].earned / weak[1].total)}%` : '—'; }
      }
    } catch {}
    const input = document.getElementById('topic-search');
    const list = document.getElementById('topic-list');
    const initial = list.innerHTML;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) { list.innerHTML = initial; return; }
      const items = topics.filter((t) => t.name.toLowerCase().includes(q) || t.slug.includes(q.replace(/\s+/g, '-')));
      list.innerHTML = items.length
        ? items.map((t) => `<li><a href="/questions/${t.slug}/"><span>${t.name}</span><span class="strand">${t.parts} questions</span></a></li>`).join('')
        : '<li class="muted">No topic matches that. <a href="/questions/">Browse all topics</a>.</li>';
    });
  </script>
</Base>
