---
import Base from '../../layouts/Base.astro';
import Hint from '../../components/Hint.astro';
import spec from '../../data/spec.json';
import { topicByslug } from '../../lib/data';
const sections = spec.filter((s) => s.level === 1);
const subs = spec.filter((s) => s.level === 2);
const total = subs.reduce((n, s) => n + s.statements.length, 0);
const PAPER = { '3.1': 'every paper', '3.2': 'Paper 1', '3.3': 'Paper 2', '3.4': 'Paper 3A', '3.5': 'Paper 3B' };
const links = (x) => [...new Set(x.statements.map((st) => st.topic).filter(Boolean))];
---
<Base title="AQA A-level Law 7162 specification checklist, tickable" description="Every content point of the AQA A-level Law (7162) specification as a tickable checklist, with links to the past-paper questions for each topic." context="specification" leadLine="Big gaps on the checklist? A tutor can plan the order to close them.">
  <h1>Specification checklist</h1>
  <p>The subject content of the AQA A-level Law specification (7162, version 1.1), point by point in AQA's wording. Tick what you're confident with; ticks are saved in this browser only. Everyone studies 3.1 to 3.3 and then either 3.4 (contract, Paper 3A) or 3.5 (human rights, Paper 3B).</p>
  <Hint id="ticks" text="Ticks are saved in this browser only. The revision planner uses them to pick your weak topics." />
  <p class="muted"><span id="done">0</span> of {total} ticked · <button class="chip" type="button" id="clear">Clear my ticks</button></p>
  {sections.map((s) => (
    <>
      <h2 class="strand-head">{s.code} {s.title} <span class="muted small-text">({PAPER[s.code]})</span></h2>
      {subs.filter((x) => x.code.startsWith(s.code + '.')).map((x) => (
        <section>
          <h3>{x.code} {x.title} {links(x).map((t) => <a class="small-text" href={`/questions/${t}/`}>{links(x).length > 1 ? topicByslug.get(t)?.name.split(':')[0].toLowerCase() + ' questions ' : 'questions'}</a>)}</h3>
          <ul class="spec-list">
            {x.statements.map((st) => <li><label><input type="checkbox" data-spec={st.id} /><span><strong>{st.id.replace(/^[\d.]+/, '')}</strong> {st.text}</span></label></li>)}
          </ul>
        </section>
      ))}
    </>
  ))}
  <script>
    const KEY = 'malt-aqa-spec';
    const boxes = document.querySelectorAll('input[data-spec]');
    const done = document.getElementById('done');
    let state = {};
    try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch {}
    const paint = () => { let n = 0; boxes.forEach((b) => { b.checked = !!state[b.dataset.spec]; if (b.checked) n++; }); done.textContent = String(n); };
    boxes.forEach((b) => b.addEventListener('change', () => { state[b.dataset.spec] = b.checked; try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} paint(); }));
    document.getElementById('clear').addEventListener('click', () => { state = {}; try { localStorage.removeItem(KEY); } catch {} paint(); });
    paint();
  </script>
</Base>
