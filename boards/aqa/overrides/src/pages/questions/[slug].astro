---
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import Motif from '../../components/Motif.astro';
import Icon from '../../components/Icon.astro';
import Hint from '../../components/Hint.astro';
import { allTopics, questionsForTopic, groupInfo, essayTitle, FIRST_SERIES } from '../../lib/data';
import { deckFor } from '../../lib/decks';
export function getStaticPaths() {
  return allTopics.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props;
const qs = questionsForTopic(topic.slug);
const years = [...new Set(qs.filter((q) => q.series !== 'Specimen').map((q) => q.year))].sort((a, b) => b - a);
const deck = deckFor(topic.slug);
const gi = groupInfo(topic.group);
const count = (f) => qs.filter((q) => q.format === f).length;
const essays = qs.filter((q) => q.format === 'Essay');
const scenarios = qs.filter((q) => q.format === 'Scenario');
const since = FIRST_SERIES.split(' ')[1];
const short = topic.name.split(':')[0];
---
<Base title={`${short}: AQA A-level Law 7162 past-paper questions`} description={`Every AQA A-level Law (7162) past-paper question on ${topic.name.toLowerCase()} since ${since} (${qs.length} question${qs.length === 1 ? '' : 's'}), with mark schemes and examiners' report comments.`} context={`topic:${topic.slug}`}>
  <div class="topic-head"><h1>{topic.name} <span class={`badge badge-${gi.badge}`}>{gi.short}</span></h1><Motif kind={gi.motif} /></div>
  <div class="where">
    <dl>
      <dt>Where it is examined</dt><dd>{gi.where}</dd>
      <dt>Specification</dt><dd>{topic.sectionTitle}: {topic.statements.length} content point{topic.statements.length === 1 ? '' : 's'}</dd>
      <dt>Since {since}</dt><dd>{qs.length ? <>{qs.length} question{qs.length === 1 ? '' : 's'}: {count('Multiple choice')} multiple choice, {count('Explain') + count('Application')} five-mark, {scenarios.length} problem question{scenarios.length === 1 ? '' : 's'}, {essays.length} essay{essays.length === 1 ? '' : 's'}</> : 'No question has been set mainly on this content yet'}</dd>
    </dl>
  </div>
  <div class="score-note" id="myscore" hidden></div>

  {deck && <div class="btn-row"><a class="btn btn-accent" href={`/questions/${topic.slug}/terms/`}><Icon name="layers" />Key terms cards ({deck.terms.length})</a></div>}

  <h2>Specification content</h2>
  <ul class="spec-list">{topic.statements.map((id) => <li><strong>{id}</strong> {topic.statementText[id]}</li>)}</ul>

  {scenarios.length > 0 && <><h2>Every problem question on this topic</h2>
  <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Q</th><th>Marks</th><th>Question</th></tr></thead>
  <tbody>{scenarios.map((q) => <tr><td>{q.series}</td><td>{q.paper}</td><td><a href={`#${q.id}`}>{q.question}</a></td><td>{q.marks}</td><td>{essayTitle(q)}</td></tr>)}</tbody></table></div></>}

  {essays.length > 0 && <><h2>Every 15-mark essay set on this topic</h2>
  <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Q</th><th>Marks</th><th>Title</th></tr></thead>
  <tbody>{essays.map((q) => <tr><td>{q.series}</td><td>{q.paper}</td><td><a href={`#${q.id}`}>{q.question}</a></td><td>{q.marks}</td><td>{essayTitle(q)}</td></tr>)}</tbody></table></div></>}

  <h2>Past-paper questions</h2>
  {qs.length === 0 ? <p>AQA has not yet set a question that is mainly on this content in the papers published since {since}. It is still on the specification: see the other <a href="/questions/">{gi.area.toLowerCase()} topics</a>.</p> : <>
  <p><a class="btn" href={`/questions/${topic.slug}/print/`}><Icon name="printer" />Print this topic as a pack</a></p>
  <div class="filterbar"><div class="chips" role="group" aria-label="Filter">
    <button class="chip" type="button" aria-pressed="true" data-filter="">All ({qs.length})</button>
    {count('Multiple choice') > 0 && <button class="chip" type="button" aria-pressed="false" data-filter="format:Multiple choice">Multiple choice</button>}
    {count('Explain') > 0 && <button class="chip" type="button" aria-pressed="false" data-filter="format:Explain">Explain (5)</button>}
    {count('Application') > 0 && <button class="chip" type="button" aria-pressed="false" data-filter="format:Application">Application (5)</button>}
    {scenarios.length > 0 && <button class="chip" type="button" aria-pressed="false" data-filter="format:Scenario">Problem questions</button>}
    {essays.length > 0 && <button class="chip" type="button" aria-pressed="false" data-filter="format:Essay">Essays</button>}
    {years.slice(0, 3).map((y) => <button class="chip" type="button" aria-pressed="false" data-filter={`year:${y}`}>{y}</button>)}
  </div><div class="count" id="count"></div></div>
  <Hint id="reveal" text="Tap a question to zoom it. The mark scheme opens underneath, then the examiners' report on the question (June papers only)." />
  {qs.map((q) => <QuestionCard q={q} />)}
  </>}

  <script define:vars={{ slug: topic.slug }}>
    try { const s = JSON.parse(localStorage.getItem('malt-aqa-scores') || '{}')[slug]; if (s && s.total) { const el = document.getElementById('myscore'); el.hidden = false; el.innerHTML = `Your practice score on this topic: <strong>${s.earned}/${s.total}</strong> (${Math.round(100 * s.earned / s.total)}%) over ${s.n} question${s.n === 1 ? '' : 's'}. <a href="/practice/">Practise more</a>`; } } catch {}
  </script>
  <script>
    const chips = document.querySelectorAll('.chip[data-filter]');
    const cards = document.querySelectorAll('.qcard');
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      const f = c.getAttribute('data-filter') || '';
      const [key, val] = f.split(':');
      cards.forEach((card) => { card.hidden = !!f && card.getAttribute('data-' + key) !== val; });
      document.getElementById('count').textContent = `Showing ${[...cards].filter((c) => !c.hidden).length} of ${cards.length}`;
    }));
  </script>
</Base>
