---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, allTopics, essayTitle, FIRST_SERIES, seriesRank } from '../../lib/data';
const essays = allQuestions.filter((q) => q.format === 'Essay').sort((a, b) => seriesRank(b.series) - seriesRank(a.series) || a.paper.localeCompare(b.paper));
const themes = allTopics.filter((t) => ['Nature of law'].includes(t.group) || t.slug.startsWith('theory-')).map((t) => [t, essays.filter((q) => q.topics.includes(t.slug))]).filter(([, qs]) => qs.length);
const byPaper = ['Paper 1', 'Paper 2', 'Paper 3A', 'Paper 3B'].map((p) => [p, essays.filter((q) => q.paper === p)]);
const since = FIRST_SERIES.split(' ')[1];
---
<Base title={`Every AQA A-level Law 15-mark essay question since ${since}, with a timed essay tool`} description={`All the 15-mark Question 9 essays set on AQA A-level Law (7162) since ${since}, by nature of law theme and by paper, with a timed-essay tool that reveals the mark scheme and its bands.`} context="essays" leadLine="Want your essays marked against AQA's bands? Message us.">
  <h1>Every 15-mark essay, and a timed practice tool</h1>
  <p>Question 9 on every paper is the extended essay: {essays.length} of them here, from {FIRST_SERIES} to June 2025 plus the specimens. Each sets a nature of law theme (the role of fault, law and morality, law and justice, balancing conflicting interests, or on Paper 1 a principle of criminal law) and asks you to discuss it against one area of the paper's substantive law. Pick one to write under timed conditions (2 hours for 100 marks is 1.2 minutes a mark, so 18 minutes), then open the mark scheme and award yourself a band.</p>
  <p class="muted">The essay is marked AO1 5 and AO3 10, and AQA's mark schemes split it 10 marks for the non-substantive theme and 5 for the substantive law. Looking for problem questions? See the <a href="/questions/type/scenarios/">10-mark and 30-mark problems</a>.</p>
  <h2>Timed essay</h2>
  <div class="panel">
    <div class="chips" id="topic-chips">{themes.map(([t]) => <button class="chip" type="button" data-topic={t.slug} aria-pressed="false">{t.name.split(':')[0]}</button>)}</div>
    <div class="chips" data-group="paper"><button class="chip" type="button" data-v="" aria-pressed="true">Any paper</button><button class="chip" type="button" data-v="Paper 1">Paper 1</button><button class="chip" type="button" data-v="Paper 2">Paper 2</button><button class="chip" type="button" data-v="Paper 3A">Paper 3A</button><button class="chip" type="button" data-v="Paper 3B">Paper 3B</button></div>
    <div><button class="btn btn-accent" type="button" id="draw">Give me a title</button> <span class="muted">(random from the selected themes, or from all)</span></div>
  </div>
  <div id="play" hidden>
    <div class="playbar"><span id="which"></span><span class="timer" id="timer">18:00</span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start the clock</button></div>
    <div id="card"></div>
    <div class="panel"><h3>Award yourself a band</h3><div class="markrow" id="levels"><span>Band:</span>{[1, 2, 3, 4, 5].map((l) => <button class="chip" type="button" data-level={l}>{l}</button>)}</div><p class="muted">AQA's bands for the 15-mark essay: Band 5 is 13–15 (excellent knowledge of the nature of law and of the legal rules, excellent analysis and evaluation, and a sustained line of reasoning to a substantiated conclusion), Band 4 10–12, Band 3 7–9, Band 2 4–6, Band 1 1–3. Read the descriptors in the mark scheme before you choose. <em>Summary by the site, being checked by our tutor.</em></p></div>
  </div>
  <h2>All titles by theme</h2>
  {themes.map(([t, qs]) => <><h3><a href={`/questions/${t.slug}/`}>{t.name}</a> <span class="muted">({qs.length})</span></h3>
    <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Title</th></tr></thead>
    <tbody>{qs.map((q) => <tr><td>{q.series}</td><td>{q.paper}</td><td><a href={`/questions/${t.slug}/#${q.id}`}>{essayTitle(q)}</a></td></tr>)}</tbody></table></div></>)}
  <h2>All titles by paper</h2>
  {byPaper.map(([p, qs]) => <><h3>{p} <span class="muted">({qs.length})</span></h3>
    <div class="table-wrap"><table><thead><tr><th>Series</th><th>Title</th></tr></thead>
    <tbody>{qs.map((q) => <tr><td>{q.series}</td><td><a href={`/questions/${q.topics[0]}/#${q.id}`}>{essayTitle(q)}</a></td></tr>)}</tbody></table></div></>)}
  <script>
    import { loadBank, card, saveScore, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = new Set(); let paper = '', bank = null, timer = null, secs = 1080, current = null;
    document.querySelectorAll('[data-topic]').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); on ? sel.add(b.dataset.topic) : sel.delete(b.dataset.topic); }));
    document.querySelectorAll('[data-group="paper"] .chip').forEach((b) => b.addEventListener('click', () => { document.querySelectorAll('[data-group="paper"] .chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); paper = b.dataset.v; }));
    loadBank().then((b) => { bank = b; });
    $('#draw').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => q.f === 'Essay' && q.c && (!paper || q.p === paper) && (!sel.size || q.t.some((t) => sel.has(t))));
      if (!pool.length) { window.maltToast && window.maltToast('No essay matches: try another paper or theme'); return; }
      current = shuffle(pool)[0];
      secs = Math.round(current.m * 72);
      $('#play').hidden = false; $('#which').textContent = `${current.s} ${current.p} Q${current.q} (${current.m} marks)`; $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      const holder = $('#card'); holder.innerHTML = ''; holder.appendChild(card(current));
      document.querySelectorAll('[data-level]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      window.scrollTo({ top: $('#play').offsetTop - 80, behavior: 'smooth' });
    });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
    document.querySelectorAll('[data-level]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('[data-level]').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true');
      if (current) saveScore(current.t, [0, 2, 5, 8, 11, 14][Number(b.dataset.level)], current.m, current.id);
    }));
  </script>
</Base>
